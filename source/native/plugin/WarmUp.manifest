<?xml version='1.0' encoding='utf-8'?>
<plugin>
  <name>WarmUp</name>
  <type>App</type>
  <file>{pluginDir}/WarmUp</file>
  <config>
    <autoStart>yes</autoStart>
    <dependencies>
      <pluginAppConnector>
        <type>Etch</type>
        <id>105</id>
        <asyncCallbacks>yes</asyncCallbacks>
      </pluginAppConnector>
    </dependencies>
    <parameters>
      <DescFile>{pluginDir}/WarmUp.xml</DescFile>
      <ImageDBFile>{pluginDir}/WarmUp_ALL_Images.zip</ImageDBFile>
    </parameters>
  </config>
</plugin>