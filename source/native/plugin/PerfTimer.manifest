<?xml version='1.0' encoding='utf-8'?>
<plugin>
  <name>PerfTimer</name>
  <type>App</type>
  <file>{pluginDir}/PerfTimer</file>
  <config>
    <autoStart>yes</autoStart>
    <dependencies>
      <pluginAppConnector>
        <type>Etch</type>
        <id>106</id>
        <asyncCallbacks>yes</asyncCallbacks>
      </pluginAppConnector>
    </dependencies>
    <parameters>
      <DescFile>{pluginDir}/PerfTimer.xml</DescFile>
      <ImageDBFile>{pluginDir}/PerfTimer_ALL_Images.zip</ImageDBFile>
    </parameters>
  </config>
</plugin>